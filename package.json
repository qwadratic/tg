{
  "name": "@qwadratic/tg",
  "version": "0.5.0",
  "description": "Read, archive and send your own Telegram from the command line or an agent",
  "keywords": [
    "telegram",
    "mtproto",
    "mtcute",
    "export",
    "markdown",
    "cli",
    "archive",
    "agent"
  ],
  "homepage": "https://github.com/qwadratic/tg#readme",
  "bugs": {
    "url": "https://github.com/qwadratic/tg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwadratic/tg.git"
  },
  "license": "ISC",
  "packageManager": "pnpm@11.9.0",
  "author": "qwadratic",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tg": "bin/tg.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "AGENTS.md",
    "skill"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --trace-warnings src/index.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "coverage": "rm -rf coverage && npx c8 tsx --test",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@mtcute/core": "^0.27.8",
    "@mtcute/node": "^0.27.8",
    "better-sqlite3-multiple-ciphers": "^12.6.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.2.3",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.0",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
