[Unit]
Description=tg: export tracked Telegram folders, then ship them into gbrain
Documentation=https://github.com/qwadratic/tg

[Service]
Type=oneshot
User=tg
Group=tg
WorkingDirectory=/srv/tg
# All four data paths are cwd-relative by design (data/session.db,
# data/session.lock, data/config.json, data/archive/), so WorkingDirectory
# is the whole configuration. /srv/tg is 0700 tg:tg.
Environment=TG_NON_INTERACTIVE=1
# folderId=gbrainSource, e.g. TG_BRAIN_MAP=7=personal,12=proximata
# A file whose folder is not in this map fails the run rather than guessing.
EnvironmentFile=-/etc/tg.env

# Two processes, in this order, and the unit aborts on the first non-zero
# exit. Step 1 holds a full Telegram account credential and never calls
# gbrain; step 2 talks to gbrain and never sees a Telegram credential. The
# separation is a process boundary, not a coding convention.
ExecStart=/usr/local/bin/tg sync chats --once --verbose
ExecStart=/usr/local/bin/tg ship

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# /srv/tg holds the archive and the credential store; ~tg/.gbrain is where
# gbrain keeps its own config, locks and the ship heartbeat. Both must be
# writable, and under ProtectSystem=strict nothing else is.
ReadWritePaths=/srv/tg /home/tg
